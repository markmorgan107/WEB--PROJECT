<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Level Up Life</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="icon" type="image/png" href="/images/arrow.png">
    <style>
        .admin-form input,
        .admin-form select,
        .admin-form textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            background: #111;
            border: 1px solid #333;
            color: white;
            border-radius: 5px;
        }

        .admin-form button {
            margin-top: 10px;
        }

        .table-container {
            overflow-x: auto;
            margin-top: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 10px;
            border-bottom: 1px solid #333;
            text-align: left;
        }

        th {
            color: #d4af37;
        }
    </style>
</head>

<body>
    <div id="vanta-bg" style="position: fixed; z-index: -1; width: 100%; height: 100vh; top: 0; left: 0;"></div>

    <nav class="navbar">
        <div class="logo" style="display: flex; align-items: center; gap: 8px;">
            <img src="/images/arrow.png" style="height: 24px; width: auto;" alt="Logo">
            Admin Portal
        </div>
        <div class="nav-links">
            <a href="/admin/logout" class="nav-login">Log Out</a>
        </div>
    </nav>

    <section style="padding-top: 150px; min-height: 100vh; padding-bottom: 100px;">
        <div class="section-header center">
            <span style="color: #ff4d4d;">System Control</span>
            <h2>Admin Dashboard</h2>
        </div>

        <!--quest requests-->
        <div class="dashboard-card" style="margin-bottom: 40px;">
            <h3 style="margin-bottom: 20px; font-size: 22px; color: #ff4d4d;">📩 Quest Requests from Users</h3>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Set Rewards & Approve</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(typeof requestedQuests !=='undefined' && requestedQuests.length> 0) { %>
                            <% requestedQuests.forEach(quest=> { %>
                                <tr>
                                    <td style="font-weight: bold; color: #d4af37;">
                                        <%= quest.userId ? quest.userId.name : 'Unknown User' %>
                                    </td>
                                    <td>
                                        <%= quest.title %>
                                    </td>
                                    <td>
                                        <%= quest.description %>
                                    </td>
                                    <td>
                                        <form action="/admin/quests/<%= quest._id %>/approve" method="POST"
                                            class="admin-form"
                                            style="margin: 0; display: flex; flex-direction: column; gap: 8px;">
                                            <div style="display: flex; gap: 10px;">
                                                <input type="number" name="xpReward" placeholder="XP" required
                                                    style="margin: 0; width: 80px;">
                                                <input type="number" name="coinsReward" placeholder="Coins" required
                                                    style="margin: 0; width: 80px;">
                                                <select name="difficulty" required style="margin: 0; width: 100px;">
                                                    <option value="easy">Easy</option>
                                                    <option value="medium">Medium</option>
                                                    <option value="hard">Hard</option>
                                                </select>
                                            </div>
                                            <button type="submit"
                                                style="background: #22c55e; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold;">Approve
                                                Quest</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4">No pending quest requests.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!--add quest section -->
        <div class="dashboard-card" style="margin-bottom: 40px;">
            <h3 style="margin-bottom: 20px; font-size: 22px;">Add Quest to All Users</h3>
            <form class="admin-form" action="/admin/quests/add" method="POST">
                <input type="text" name="title" placeholder="Quest Title" required>
                <textarea name="description" placeholder="Quest Description" required></textarea>
                <input type="number" name="xpReward" placeholder="XP Reward" required>
                <input type="number" name="coinsReward" placeholder="Coins Reward" required>
                <select name="difficulty" required>
                    <option value="easy">Easy</option>
                    <option value="medium">Medium</option>
                    <option value="hard">Hard</option>
                </select>
                <button type="submit" class="btn btn-primary">Distribute Quest</button>
            </form>

            <h4 style="margin-top: 30px;">Existing Quests</h4>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>XP</th>
                            <th>Coins</th>
                            <th>Difficulty</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(typeof quests !=='undefined' && quests.length> 0) { %>
                            <% quests.forEach(quest=> { %>
                                <tr>
                                    <td>
                                        <form action="/admin/quests/edit" method="POST" style="display:inline;">
                                            <input type="hidden" name="oldTitle" value="<%= quest._id %>">
                                            <input type="text" name="title" value="<%= quest._id %>"
                                                style="width:100%; background:#222; color:white; border:1px solid #444; padding:5px;">
                                    </td>
                                    <td>
                                        <textarea name="description"
                                            style="width:100%; background:#222; color:white; border:1px solid #444; padding:5px;"><%= quest.description %></textarea>
                                    </td>
                                    <td>
                                        <input type="number" name="xpReward" value="<%= quest.xpReward %>"
                                            style="width:60px; background:#222; color:white; border:1px solid #444; padding:5px;">
                                    </td>
                                    <td>
                                        <input type="number" name="coinsReward" value="<%= quest.coinsReward %>"
                                            style="width:60px; background:#222; color:white; border:1px solid #444; padding:5px;">
                                    </td>
                                    <td>
                                        <select name="difficulty"
                                            style="background:#222; color:white; border:1px solid #444; padding:5px;">
                                            <option value="easy" <%=quest.difficulty==='easy' ? 'selected' : '' %>>Easy
                                            </option>
                                            <option value="medium" <%=quest.difficulty==='medium' ? 'selected' : '' %>
                                                >Medium</option>
                                            <option value="hard" <%=quest.difficulty==='hard' ? 'selected' : '' %>>Hard
                                            </option>
                                        </select>
                                    </td>
                                    <td>
                                        <button type="submit"
                                            style="background: #d4af37; color: black; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; margin-bottom: 5px;">Save</button>
                                        </form>
                                        <form action="/admin/quests/remove" method="POST" style="display:inline;">
                                            <input type="hidden" name="title" value="<%= quest._id %>">
                                            <button type="submit"
                                                style="background: red; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer;">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6">No active quests found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!--shop items section-->
        <div class="dashboard-card" style="margin-bottom: 40px;">
            <h3 style="margin-bottom: 20px; font-size: 22px;">Manage Shop Items</h3>
            <form class="admin-form" action="/admin/shop/add" method="POST"
                style="margin-bottom: 30px; border-bottom: 1px solid #333; padding-bottom: 20px;">
                <h4>Add New Item</h4>
                <input type="text" name="name" placeholder="Item Name" required>
                <textarea name="description" placeholder="Item Description" required></textarea>
                <input type="number" name="cost" placeholder="Coin Cost" required>
                <select name="type" required>
                    <option value="badge">Badge</option>
                    <option value="theme">Theme</option>
                    <option value="boost">Boost</option>
                    <option value="trophy">Trophy</option>
                </select>
                <select name="rarity" required>
                    <option value="common">Common</option>
                    <option value="rare">Rare</option>
                    <option value="epic">Epic</option>
                    <option value="legendary">Legendary</option>
                </select>
                <button type="submit" class="btn btn-primary">Add to Shop</button>
            </form>

            <h4>Existing Items</h4>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Cost</th>
                            <th>Type</th>
                            <th>Rarity</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(typeof shopItems !=='undefined' && shopItems.length> 0) { %>
                            <% shopItems.forEach(item=> { %>
                                <tr>
                                    <td>
                                        <%= item.name %>
                                    </td>
                                    <td>
                                        <%= item.cost %> Coins
                                    </td>
                                    <td>
                                        <%= item.type %>
                                    </td>
                                    <td>
                                        <%= item.rarity %>
                                    </td>
                                    <td>
                                        <form action="/admin/shop/<%= item._id %>/remove" method="POST"
                                            style="display:inline;">
                                            <button type="submit"
                                                style="background: red; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer;">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5">No shop items.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!--users-->
        <div class="dashboard-card">
            <h3 style="margin-bottom: 20px; font-size: 22px;">User Directory</h3>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Level</th>
                            <th>XP</th>
                            <th>Coins</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(typeof users !=='undefined' && users.length> 0) { %>
                            <% users.forEach(user=> { %>
                                <tr>
                                    <td>
                                        <%= user.name || 'N/A' %>
                                    </td>
                                    <td>
                                        <%= user.email %>
                                    </td>
                                    <td>
                                        <%= user.level %>
                                    </td>
                                    <td>
                                        <%= user.xp %>
                                    </td>
                                    <td>
                                        <%= user.coins %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5">No users found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </section>

    <footer class="footer">
        <p>© 2026 Level Up Life. All rights reserved.</p>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
    <script>
        VANTA.NET({
            el: "#vanta-bg",
            mouseControls: true, touchControls: true, gyroControls: false,
            minHeight: 200.00, minWidth: 200.00, scale: 1.00, scaleMobile: 1.00,
            color: 0xff0000, backgroundColor: 0x0c0c0c // Red theme for admin
        })
    </script>
</body>

</html>