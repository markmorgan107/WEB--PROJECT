<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - Level Up Life</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/authorization.css">
  <link rel="icon" type="image/png" href="/images/arrow.png">
</head>

<body>
  <div id="vanta-bg" style="position: fixed; z-index: -1; width: 100%; height: 100vh; top: 0; left: 0;"></div>
  <a href="/" class="btn-home">Home</a>

  <div class="login-container">
    <div class="login-box">
      <h1>Admin Portal</h1>
      <p>Log in with an administrator account</p>

      <% if (typeof error !== 'undefined') { %>
        <div class="error-msg" style="color: #ff4d4d; margin-bottom: 15px; text-align: center; display: block;"><%= error %></div>
      <% } %>
      <form action="/admin/login" method="POST">
        <input type="email" name="email" id="email" placeholder="Admin Email" required>
        <input type="password" name="password" id="password" placeholder="Password" required>
        <button type="submit" class="btn btn-primary">Log In</button>
      </form>
    </div>
  </div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    VANTA.NET({
      el: "#vanta-bg",
      mouseControls: true, touchControls: true, gyroControls: false,
      minHeight: 200.00, minWidth: 200.00, scale: 1.00, scaleMobile: 1.00,
      color: 0xff0000, backgroundColor: 0x0c0c0c // Red theme for admin
    })
  </script>
</body>

</html>
