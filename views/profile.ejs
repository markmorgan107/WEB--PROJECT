<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - Level Up Life</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="icon" type="image/png" href="/images/arrow.png">
</head>

<body>
  <div id="vanta-bg" style="position: fixed; z-index: -1; width: 100%; height: 100vh; top: 0; left: 0;"></div>

  <nav class="navbar">
    <div class="logo" style="display: flex; align-items: center; gap: 8px;">
        <img src="/images/arrow.png" style="height: 24px; width: auto;" alt="Logo">
        Level Up Life
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/quests">Quests</a>
      <a href="/leaderboard">Leaderboard</a>
      <a href="/shop">Shop</a>
      <a href="/profile">Profile</a>
      <a href="/inventory">Inventory</a>
      <a href="/" class="nav-login">Log Out</a>
    </div>
  </nav>

  <section style="padding-top: 150px; min-height: 100vh; padding-bottom: 100px;">
    <div class="section-header center">
      <span style="color: #d4af37;">Deep Profile</span>
      <h2>Skill Tree</h2>
      <p>Analyze how your life choices are leveling up different aspects of your character.</p>
    </div>

    <div class="main-content" style="max-width: 900px; margin: 0 auto; width: 100%;">
      <div class="dashboard-card" style="width: 100%; margin-bottom: 40px;">
        <div class="profile-top">
          <div class="avatar" style="width: 100px; height: 100px; font-size: 40px;">A</div>
          <div>
            <h3 style="font-size: 36px;"><%= typeof username !== 'undefined' ? username : 'Alex Carter' %></h3>
            <p style="font-size: 18px;">Level <%= typeof level !== 'undefined' ? level : 8 %> • Productivity Builder</p>
          </div>
        </div>
      </div>

      <h3 style="text-align: left; width: 100%; font-size: 24px; margin-bottom: 20px;">Character Stats</h3>
      <div class="skill-tree-grid">
        <% if (typeof skills !== 'undefined' && skills.length > 0) { %>
          <% skills.forEach(skill => { %>
          <div class="skill-node">
            <h4><%= skill.name %></h4>
            <div class="skill-level">Lvl <%= skill.level %></div>
            <p><%= skill.description %></p>
            <% const nextLevelReq = requiredXpForLevel(skill.level + 1); %>
            <% let xpToCurrentLevel = 0; for (let l = 2; l <= skill.level; l++) { xpToCurrentLevel += requiredXpForLevel(l); } %>
            <% const xpInLevel = Math.max(0, skill.xp - xpToCurrentLevel); %>
            <% const percent = Math.min(100, Math.round((xpInLevel / nextLevelReq) * 100)); %>
            <div style="display: flex; justify-content: space-between; margin-top: 10px; margin-bottom: 5px; font-size: 13px; color: #a3a3a3;">
              <span>Progress to Lvl <%= skill.level + 1 %></span>
              <span><%= xpInLevel %>/<%= nextLevelReq %> XP</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width: <%= percent %>%;"></div>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p style="color: #9ca3af; grid-column: 1 / -1;">No skills found.</p>
        <% } %>
      </div>
    </div>
  </section>

  <footer class="footer">
    <p>© 2026 Level Up Life. All rights reserved.</p>
  </footer>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    VANTA.NET({
      el: "#vanta-bg",
      mouseControls: true, touchControls: true, gyroControls: false,
      minHeight: 200.00, minWidth: 200.00, scale: 1.00, scaleMobile: 1.00,
      color: 0xd4af37, backgroundColor: 0x0c0c0c
    })
  </script>
</body>

</html>
