<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory - Level Up Life</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/inventory.css">
  <link rel="icon" type="image/png" href="/images/arrow.png">
</head>

<body>
  <div id="vanta-bg" style="position: fixed; z-index: -1; width: 100%; height: 100vh; top: 0; left: 0;"></div>

  <nav class="navbar">
    <div class="logo" style="display: flex; align-items: center; gap: 8px;">
        <img src="/images/arrow.png" style="height: 24px; width: auto;" alt="Logo">
        Level Up Life
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/quests">Quests</a>
      <a href="/leaderboard">Leaderboard</a>
      <a href="/shop">Shop</a>
      <a href="/profile">Profile</a>
      <a href="/inventory">Inventory</a>
      <a href="/auth/logout" class="nav-login">Log Out</a>
    </div>
  </nav>

  <section style="padding-top: 150px; min-height: 100vh; padding-bottom: 100px;">
    <div class="section-header center">
      <span style="color: #d4af37;">Armory</span>
      <h2>Your Inventory</h2>
      <p>View your collected trophies, achievement badges, and unlocked titles.</p>
    </div>

    <div class="main-content" style="max-width: 1000px; margin: 0 auto; width: 100%;">
      <h3 style="text-align: left; width: 100%; font-size: 24px; margin-bottom: 10px;">Badges & Trophies</h3>
      <div class="grid-cards" style="margin-bottom: 50px;">
        <% if (typeof inventory !== 'undefined' && inventory.length > 0) { %>
          <% inventory.forEach(item => { %>
          <div class="inventory-card">
            <div class="card-icon" style="filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.5));">
              <%= item.type === 'badge' ? '🔥' : (item.type === 'trophy' ? '🏆' : '⭐') %>
            </div>
            <h4 class="card-title"><%= item.itemName %></h4>
            <p class="card-desc"><%= item.description %></p>
          </div>
          <% }) %>
        <% } else { %>
          <p style="color: #9ca3af; grid-column: 1 / -1;">Your inventory is empty.</p>
        <% } %>
      </div>
    </div>
  </section>

  <footer class="footer">
    <p>© 2026 Level Up Life. All rights reserved.</p>
  </footer>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    VANTA.NET({
      el: "#vanta-bg",
      mouseControls: true, touchControls: true, gyroControls: false,
      minHeight: 200.00, minWidth: 200.00, scale: 1.00, scaleMobile: 1.00,
      color: 0xd4af37, backgroundColor: 0x0c0c0c
    })
  </script>
</body>

</html>
