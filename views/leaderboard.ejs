<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leaderboard - Level Up Life</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/leaderboard.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="icon" type="image/png" href="/images/arrow.png">
</head>

<body>
  <div id="vanta-bg" style="position: fixed; z-index: -1; width: 100%; height: 100vh; top: 0; left: 0;"></div>

  <nav class="navbar">
    <div class="logo" style="display: flex; align-items: center; gap: 8px;">
        <img src="/images/arrow.png" style="height: 24px; width: auto;" alt="Logo">
        Level Up Life
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/quests">Quests</a>
      <a href="/leaderboard">Leaderboard</a>
      <a href="/shop">Shop</a>
      <a href="/profile">Profile</a>
      <a href="/inventory">Inventory</a>
      <a href="/auth/logout" class="nav-login">Log Out</a>
    </div>
  </nav>

  <section style="padding-top: 150px; min-height: 100vh; padding-bottom: 100px;">
    <div class="section-header center">
      <span style="color: #d4af37;">The Arena</span>
      <h2>Global Leaderboard</h2>
      <p>See where you stand among the most disciplined users. Rise through the ranks by completing quests.</p>
    </div>

    <div class="dashboard-card" style="max-width: 900px;">
      <table class="leaderboard-table">
        <thead>
          <tr>
            <th>Rank</th>
            <th>Avatar</th>
            <th>User</th>
            <th>Title</th>
            <th>Total XP</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof leaderboard !== 'undefined' && leaderboard.length > 0) { %>
            <% leaderboard.forEach((user, index) => { %>
              <tr class="<%= index < 3 ? 'rank-' + (index + 1) : '' %>">
                <td>#<%= index + 1 %></td>
                <td><div class="avatar" style="width: 40px; height: 40px; font-size: 16px; <%= index === 1 ? 'background: #c0c0c0;' : (index === 2 ? 'background: #cd7f32;' : (index > 2 ? 'background: #333; color: white;' : '')) %>"><%= user.name ? user.name.charAt(0).toUpperCase() : '?' %></div></td>
                <td><strong><%= user.name || 'Unknown' %></strong></td>
                <td>Level <%= user.level %></td>
                <td><%= user.xp.toLocaleString() %> XP</td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" style="text-align: center; color: #9ca3af;">No leaderboard data available.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <footer class="footer">
    <p>© 2026 Level Up Life. All rights reserved.</p>
  </footer>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    VANTA.NET({
      el: "#vanta-bg",
      mouseControls: true, touchControls: true, gyroControls: false,
      minHeight: 200.00, minWidth: 200.00, scale: 1.00, scaleMobile: 1.00,
      color: 0xd4af37, backgroundColor: 0x0c0c0c
    })
  </script>
</body>

</html>
