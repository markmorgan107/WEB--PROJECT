<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Level Up Life</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/quests.css">
  <link rel="icon" type="image/png" href="/images/arrow.png">
</head>

<body>
  <div id="vanta-bg" style="position: fixed; z-index: -1; width: 100%; height: 100vh; top: 0; left: 0;"></div>

  <nav class="navbar">
    <div class="logo" style="display: flex; align-items: center; gap: 8px;">
        <img src="/images/arrow.png" style="height: 24px; width: auto;" alt="Logo">
        Level Up Life
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/quests">Quests</a>
      <a href="/leaderboard">Leaderboard</a>
      <a href="/shop">Shop</a>
      <a href="/profile">Profile</a>
      <a href="/inventory">Inventory</a>
      <a href="/" class="nav-login">Log Out</a>
    </div>
  </nav>

  <section style="padding-top: 150px; min-height: 100vh;">
    <div class="dashboard-card">
      <div class="profile-top">
        <div class="avatar">A</div>
        <div>
          <h3><%= typeof username !== 'undefined' ? username : 'Alex Carter' %></h3>
          <p>Level <%= typeof level !== 'undefined' ? level : 8 %> • Productivity Builder</p>
        </div>
      </div>

      <div class="stats-row">
        <div class="stat-box">
          <strong><%= typeof totalXp !== 'undefined' ? totalXp : 0 %></strong>
          <span>Total XP</span>
        </div>
        <div class="stat-box">
          <strong><%= typeof coins !== 'undefined' ? coins : 0 %></strong>
          <span>Coins</span>
        </div>
        <div class="stat-box">
          <strong>0</strong>
          <span>Day Streak</span>
        </div>
      </div>

      <div class="progress-area">
        <div class="progress-label">
          <span>Progress to Level <%= (typeof level !== 'undefined' ? level : 1) + 1 %> &nbsp;<%= typeof xpInCurrentLevel !== 'undefined' ? xpInCurrentLevel : 0 %>/<%= typeof requiredXp !== 'undefined' ? requiredXp : 0 %> XP</span>
          <span><%= typeof requiredXp !== 'undefined' && requiredXp > 0 ? Math.min(100, Math.round(((xpInCurrentLevel || 0) / requiredXp) * 100)) : 0 %>%</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill" style="width: <%= typeof requiredXp !== 'undefined' && requiredXp > 0 ? Math.min(100, Math.round(((xpInCurrentLevel || 0) / requiredXp) * 100)) : 0 %>%;"></div>
        </div>
      </div>

      <div class="quest-list">
        <% if (typeof quests !== 'undefined' && quests.length > 0) { %>
          <% quests.forEach(quest => { %>
          <div class="quest-item">
            <div>
              <h4><%= quest.title %></h4>
              <p>+<%= quest.xpReward %> XP • <span style="text-transform: capitalize; color: #d4af37; font-size: 13px;"><%= quest.skill || 'mindfulness' %></span></p>
            </div>
            <span class="status <%= quest.status === 'completed' ? 'done' : '' %>"
              <% if (quest.status === 'pending') { %> onclick="acceptQuest('<%= quest._id %>')" style="cursor: pointer;" <% } %>
              <% if (quest.status === 'active') { %> onclick="completeQuest('<%= quest._id %>')" style="cursor: pointer;" <% } %>
            >
              <%= quest.status === 'completed' ? 'Done' : (quest.status === 'active' ? 'Complete' : 'Accept') %>
            </span>
          </div>
          <% }) %>
        <% } else { %>
          <p style="color: #9ca3af;">No active quests found.</p>
        <% } %>
      </div>
    </div>
  </section>

  <footer class="footer">
    <p>© 2026 Level Up Life. All rights reserved.</p>
  </footer>

  <script src="/js/webproject.js"></script>
  <script src="/js/actions.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    VANTA.NET({
      el: "#vanta-bg",
      mouseControls: true, touchControls: true, gyroControls: false,
      minHeight: 200.00, minWidth: 200.00, scale: 1.00, scaleMobile: 1.00,
      color: 0xd4af37, backgroundColor: 0x0c0c0c
    })
  </script>
</body>

</html>
