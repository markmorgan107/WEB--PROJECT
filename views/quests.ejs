<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quests - Level Up Life</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quests.css">
  <link rel="icon" type="image/png" href="/images/arrow.png">
</head>

<body>
  <div id="vanta-bg" style="position: fixed; z-index: -1; width: 100%; height: 100vh; top: 0; left: 0;"></div>

  <nav class="navbar">
    <div class="logo" style="display: flex; align-items: center; gap: 8px;">
        <img src="/images/arrow.png" style="height: 24px; width: auto;" alt="Logo">
        Level Up Life
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/quests">Quests</a>
      <a href="/leaderboard">Leaderboard</a>
      <a href="/shop">Shop</a>
      <a href="/profile">Profile</a>
      <a href="/inventory">Inventory</a>
      <a href="/auth/logout" class="nav-login">Log Out</a>
    </div>
  </nav>

  <section style="padding-top: 150px; min-height: 100vh; padding-bottom: 100px;">
    <div class="section-header center">
      <span style="color: #d4af37;">Daily Challenges</span>
      <h2>Available Quests</h2>
      <p>Accept daily tasks to gain XP, stack coins, and level up your discipline.</p>
    </div>

    <% const easyQuests = typeof quests !== 'undefined' ? quests.filter(q => q.difficulty === 'easy') : []; %>
    <% const mediumQuests = typeof quests !== 'undefined' ? quests.filter(q => q.difficulty === 'medium') : []; %>
    <% const hardQuests = typeof quests !== 'undefined' ? quests.filter(q => q.difficulty === 'hard') : []; %>

    <div class="dashboard-card" style="margin-bottom: 40px;">
      <h3 style="margin-bottom: 20px; font-size: 22px; color: #d1d5db;">🟢 Easy</h3>
      <div class="quest-list">
        <% easyQuests.forEach(quest => { %>
        <div class="quest-item">
          <div>
            <h4><%= quest.title %></h4>
            <p>+<%= quest.xpReward %> XP</p>
          </div>
          <span class="status <%= quest.status === 'completed' ? 'done' : '' %>"
            <% if (quest.status === 'pending') { %> onclick="acceptQuest('<%= quest._id %>')" style="cursor: pointer;" <% } %>
            <% if (quest.status === 'active') { %> onclick="completeQuest('<%= quest._id %>')" style="cursor: pointer;" <% } %>
          >
            <%= quest.status === 'completed' ? 'Done' : (quest.status === 'active' ? 'Complete' : 'Accept') %>
          </span>
        </div>
        <% }) %>
        <% if(easyQuests.length === 0) { %><p style="color: #9ca3af;">No easy quests available.</p><% } %>
      </div>
    </div>

    <div class="dashboard-card" style="margin-bottom: 40px;">
      <h3 style="margin-bottom: 20px; font-size: 22px; color: #d1d5db;">🟡 Medium</h3>
      <div class="quest-list">
        <% mediumQuests.forEach(quest => { %>
        <div class="quest-item">
          <div>
            <h4><%= quest.title %></h4>
            <p>+<%= quest.xpReward %> XP</p>
          </div>
          <span class="status <%= quest.status === 'completed' ? 'done' : '' %>"
            <% if (quest.status === 'pending') { %> onclick="acceptQuest('<%= quest._id %>')" style="cursor: pointer;" <% } %>
            <% if (quest.status === 'active') { %> onclick="completeQuest('<%= quest._id %>')" style="cursor: pointer;" <% } %>
          >
            <%= quest.status === 'completed' ? 'Done' : (quest.status === 'active' ? 'Complete' : 'Accept') %>
          </span>
        </div>
        <% }) %>
        <% if(mediumQuests.length === 0) { %><p style="color: #9ca3af;">No medium quests available.</p><% } %>
      </div>
    </div>

    <div class="dashboard-card">
      <h3 style="margin-bottom: 20px; font-size: 22px; color: #d1d5db;">🔴 Hard</h3>
      <div class="quest-list">
        <% hardQuests.forEach(quest => { %>
        <div class="quest-item">
          <div>
            <h4><%= quest.title %></h4>
            <p>+<%= quest.xpReward %> XP</p>
          </div>
          <span class="status <%= quest.status === 'completed' ? 'done' : '' %>"
            <% if (quest.status === 'pending') { %> onclick="acceptQuest('<%= quest._id %>')" style="cursor: pointer;" <% } %>
            <% if (quest.status === 'active') { %> onclick="completeQuest('<%= quest._id %>')" style="cursor: pointer;" <% } %>
          >
            <%= quest.status === 'completed' ? 'Done' : (quest.status === 'active' ? 'Complete' : 'Accept') %>
          </span>
        </div>
        <% }) %>
        <% if(hardQuests.length === 0) { %><p style="color: #9ca3af;">No hard quests available.</p><% } %>
      </div>
    </div>

  </section>

  <footer class="footer">
    <p>© 2026 Level Up Life. All rights reserved.</p>
  </footer>

  <script src="/js/actions.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    VANTA.NET({
      el: "#vanta-bg",
      mouseControls: true, touchControls: true, gyroControls: false,
      minHeight: 200.00, minWidth: 200.00, scale: 1.00, scaleMobile: 1.00,
      color: 0xd4af37, backgroundColor: 0x0c0c0c
    })
  </script>
</body>

</html>
