<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - Level Up Life</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/authorization.css">
  <link rel="icon" type="image/png" href="/images/arrow.png">
</head>

<body>
  <div id="vanta-bg" style="position: fixed; z-index: -1; width: 100%; height: 100vh; top: 0; left: 0;"></div>
  <a href="/" class="btn-home">Home</a>

  <div class="login-container">
    <div class="login-box">
      <h1>Reset Password</h1>
      <p>Enter your email to receive a reset link</p>

      <% if (typeof error !== 'undefined') { %>
        <div class="error-msg" style="color: #ff4d4d; margin-bottom: 15px; text-align: center; display: block;"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined') { %>
        <div class="success-msg" style="color: #4caf50; margin-bottom: 15px; text-align: center; display: block;"><%= success %></div>
      <% } %>
      <form onsubmit="return validateForgotPassword()" action="/auth/forgot-password" method="POST">
        <span id="error" class="error-msg"></span>
        <input type="email" id="email" name="email" placeholder="Email">
        <span id="emailerror" class="error-msg"></span>
        
        <button type="submit" class="btn btn-primary">Send Reset Link</button>
      </form>

      <p class="login-footer">
        Remembered your password? <a href="/login">Log in</a>
      </p>
    </div>
  </div>
  <script src="/js/webproject.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    VANTA.NET({
      el: "#vanta-bg",
      mouseControls: true, touchControls: true, gyroControls: false,
      minHeight: 200.00, minWidth: 200.00, scale: 1.00, scaleMobile: 1.00,
      color: 0xd4af37, backgroundColor: 0x0c0c0c
    })
  </script>
</body>

</html>
